# macOS and editor metadata
.DS_Store
.vscode/
.idea/

# Python caches and local environments
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Local secrets and credentials
.env
.env.*
!.env.example
*.pem
*.key
*credentials*
*secret*

# Large datasets, trajectories, databases, and tabular results
*.extxyz
*.xyz
*.parquet
*.csv
*.jsonl
*.db
*.sqlite
*.sqlite3
*.traj
*.npy
*.npz
*.h5
*.hdf5
*.pkl

# Model weights and binary artifacts
*.model
*.ckpt
*.pth
*.pt
*.onnx
*.bin

# Logs, generated plots, archives, and run outputs
*.log
*.out
*.png
*.jpg
*.jpeg
*.tif
*.tiff
*.pdf
*.zip
*.tar
*.tar.gz
*.tgz
outputs/**
!outputs/.gitkeep

# VASP/MD generated outputs (retain input configs such as INCAR/POSCAR/KPOINTS)
OUTCAR
vasprun.xml
XDATCAR
OSZICAR
REPORT
PCDAT
CONTCAR
WAVECAR
CHGCAR
POTCAR

# Keep model documentation in place, but exclude downloaded model files
models/**
!models/**/
!models/**/*.md
!models/*.joblib
!models/**/*.model
!models/**/*.ckpt
!models/**/*.pth
!models/**/*.pth.tar

# Large JSON dataset; small JSON metadata/configuration files remain eligible
data/mp-r2scan/MPr2SCAN.json

# The complete dataset is hosted on Hugging Face; keep only its pointer README on GitHub
data/**
!data/README.md
